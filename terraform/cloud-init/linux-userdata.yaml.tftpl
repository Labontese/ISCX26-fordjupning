#cloud-config
hostname: iscx26-vg-linux
manage_etc_hosts: true

users:
  - name: daniel
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: [sudo, adm]
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
packages:
  - qemu-guest-agent
  - acl
  - tcpdump
  - bind9-dnsutils
  - traceroute

runcmd:
  - systemctl enable --now qemu-guest-agent
